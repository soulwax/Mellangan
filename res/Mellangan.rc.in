#include <windows.h>

#define IDI_APPICON 101
IDI_APPICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/res/icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "soulwax\0"
            VALUE "FileDescription",  "Mellangan - Action Roguelike\0"
            VALUE "FileVersion",      "@MELLANGAN_VERSION@.0\0"
            VALUE "InternalName",     "Mellangan\0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 soulwax\0"
            VALUE "OriginalFilename", "Mellangan.exe\0"
            VALUE "ProductName",      "Mellangan\0"
            VALUE "ProductVersion",   "@MELLANGAN_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

